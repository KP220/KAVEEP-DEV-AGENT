{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kaveep.dev/dev-agent/schemas/static-validation-request.schema.json","title":"KAVEEP DEV-AGENT Static Validation Request","type":"object","required":["validationRequestId","schemaVersion","sandboxId","manifestRef","operation","files","limits","status","createdAt"],"properties":{"validationRequestId":{"type":"string","pattern":"^static_validation_request_[A-Za-z0-9][A-Za-z0-9_-]*$"},"schemaVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"sandboxId":{"type":"string","pattern":"^sandbox_[A-Za-z0-9][A-Za-z0-9_-]*$"},"manifestRef":{"type":"string","minLength":1},"operation":{"type":"string","const":"node_syntax_check"},"files":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"limits":{"type":"object","required":["maxFiles","timeoutMsPerFile","maxOutputBytes"],"properties":{"maxFiles":{"type":"integer","minimum":1,"maximum":100},"timeoutMsPerFile":{"type":"integer","minimum":100,"maximum":30000},"maxOutputBytes":{"type":"integer","minimum":1024,"maximum":1048576}},"additionalProperties":false},"status":{"type":"string","const":"proposed"},"createdAt":{"type":"string","format":"date-time"}},"additionalProperties":false}
