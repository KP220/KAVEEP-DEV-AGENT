{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kaveep.dev/dev-agent/schemas/controlled-write-request.schema.json","title":"KAVEEP DEV-AGENT Controlled Write Request","type":"object","required":["writeRequestId","schemaVersion","sandboxId","manifestRef","approvalLedgerRef","reviewedChange","approvalVerification","protectedPaths","limits","status","createdAt"],"properties":{"writeRequestId":{"type":"string","pattern":"^controlled_write_request_[A-Za-z0-9][A-Za-z0-9_-]*$"},"schemaVersion":{"type":"string","const":"1.0.0"},"sandboxId":{"type":"string","pattern":"^sandbox_[A-Za-z0-9][A-Za-z0-9_-]*$"},"manifestRef":{"type":"string","minLength":1},"approvalLedgerRef":{"type":"string","minLength":1},"reviewedChange":{"$ref":"reviewed-change-artifact.schema.json"},"approvalVerification":{"$ref":"change-approval-verification-result.schema.json"},"protectedPaths":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"limits":{"type":"object","required":["maxChangedFiles","maxFileBytes","maxTotalWriteBytes","maxPatchBytes","maxDiffLines"],"properties":{"maxChangedFiles":{"type":"integer","minimum":1,"maximum":500},"maxFileBytes":{"type":"integer","minimum":1,"maximum":10485760},"maxTotalWriteBytes":{"type":"integer","minimum":1,"maximum":104857600},"maxPatchBytes":{"type":"integer","minimum":1,"maximum":52428800},"maxDiffLines":{"type":"integer","minimum":1,"maximum":200000}},"additionalProperties":false},"status":{"type":"string","const":"approved_for_single_write_attempt"},"createdAt":{"type":"string","format":"date-time"}},"additionalProperties":false}
