{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kaveep.dev/dev-agent/schemas/container-validation-request.schema.json","title":"KAVEEP Container Validation Request","type":"object","required":["containerRequestId","schemaVersion","sandboxId","manifestRef","executionProfile","image","allowedImages","operations","limits","status","createdAt"],"properties":{"containerRequestId":{"type":"string","pattern":"^container_validation_request_[A-Za-z0-9][A-Za-z0-9_-]*$"},"schemaVersion":{"type":"string","const":"1.0.0"},"sandboxId":{"type":"string","pattern":"^sandbox_[A-Za-z0-9][A-Za-z0-9_-]*$"},"manifestRef":{"type":"string","minLength":1},"executionProfile":{"type":"string","enum":["node","python","go","rust"]},"image":{"type":"string","minLength":1},"allowedImages":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"operations":{"type":"array","items":{"type":"string","enum":["lint","typecheck","test","build"]},"uniqueItems":true},"limits":{"type":"object","required":["timeoutMsPerOperation","maxOutputBytes","memoryMb","cpus","pids"],"properties":{"timeoutMsPerOperation":{"type":"integer","minimum":1000,"maximum":1800000},"maxOutputBytes":{"type":"integer","minimum":1024,"maximum":10485760},"memoryMb":{"type":"integer","minimum":64,"maximum":8192},"cpus":{"type":"number","minimum":0.1,"maximum":8},"pids":{"type":"integer","minimum":16,"maximum":1024}},"additionalProperties":false},"status":{"type":"string","const":"proposed"},"createdAt":{"type":"string","format":"date-time"}},"additionalProperties":false}
