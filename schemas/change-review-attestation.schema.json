{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kaveep.dev/dev-agent/schemas/change-review-attestation.schema.json","title":"KAVEEP DEV-AGENT Change Review Attestation","type":"object","required":["attestationId","schemaVersion","approvalRequestRef","riskAssessmentRef","reviewedChangeRef","patchSha256","decision","reviewerId","issuedAt","expiresAt","nonce","oneTimeUse","revoked","signatureAlgorithm","signature"],"properties":{"attestationId":{"type":"string","pattern":"^change_review_attestation_[A-Za-z0-9][A-Za-z0-9_-]*$"},"schemaVersion":{"type":"string","const":"1.0.0"},"approvalRequestRef":{"type":"string","minLength":1},"riskAssessmentRef":{"type":"string","minLength":1},"reviewedChangeRef":{"type":"string","pattern":"^reviewed_change_[A-Za-z0-9][A-Za-z0-9_-]*$"},"patchSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"decision":{"type":"string","enum":["approved","rejected"]},"reviewerId":{"type":"string","minLength":1},"issuedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"},"nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{16,128}$"},"oneTimeUse":{"type":"boolean","const":true},"revoked":{"type":"boolean"},"signatureAlgorithm":{"type":"string","const":"hmac-sha256"},"signature":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}
